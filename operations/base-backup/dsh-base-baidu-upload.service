[Unit]
Description=Encrypted online backup of the real base workspace to Baidu
After=network-online.target docker.service
RequiresMountsFor=/data/example-workspace/workspace /data/dsh-workspace-archives
[Service]
Type=oneshot
UMask=0077
Nice=15
IOSchedulingClass=idle
ExecStart=/usr/bin/python3 -I /var/lib/dsh-workspace-private/workspace.py publish
TimeoutStartSec=0
